# Copy this file to .env and fill in real values. Never commit .env itself.

# Get this from https://resend.com/api-keys (free tier is fine for testing)
RESEND_API_KEY=

# The "from" address Resend sends OTP emails as. Until you verify your own
# domain in Resend, you must use their shared testing address:
#   EMAIL_FROM=CodeSprint <onboarding@resend.dev>
# Once you verify a domain (see README "Configuring Resend"), switch to:
#   EMAIL_FROM=CodeSprint <noreply@yourdomain.com>
EMAIL_FROM=CodeSprint <onboarding@resend.dev>

# Any long random string — used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the backend listens on. The frontend dev server proxies /api here.
PORT=4000

# Comma-separated list of origins allowed to call this API. The Vite dev
# server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173
